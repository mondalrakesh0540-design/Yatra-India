# ===================================================================
# YATRA INDIA — PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# 2. Database Configuration (MongoDB)
# Local MongoDB connection (Default):
MONGODB_URI=mongodb://127.0.0.1:27017/yatra_india
# Production Cloud MongoDB Atlas connection:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/yatra_india?retryWrites=true&w=majority

# 3. JWT Authentication Security
# Generate a strong 32+ character random secret for production
JWT_SECRET=yatra_india_production_secret_key_2026_secured
JWT_EXPIRES_IN=7d

# 4. Email Service (Nodemailer - For password reset flow)
# Leave blank to log reset links to server console in development
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM_NAME="Yatra India Security"
EMAIL_FROM_ADDRESS="security@yatraindia.com"

# 5. Frontend Client Environment Variables (Vite)
VITE_API_URL=http://localhost:5000/api
